    gamma="scale",
    random_state=42
)

rbf_svm_demo.fit(X_svm_demo_train, y_svm_demo_train)

plot_svm_decision_boundary(
    rbf_svm_demo,
    X_svm_demo,
    y_svm_demo,
    "RBF SVM Decision Boundary"
)





for C in [0.01, 0.1, 1, 10, 100]:
